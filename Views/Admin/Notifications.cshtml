@model System.Collections.Generic.List<Shinogi.Domain.Notification>
<section>
    <h1>Admin</h1>
    <div class="tab-nav">
        <a asp-action="Challenges">Challenges</a>
        <a asp-action="Submissions">Submissions</a>
        <a asp-action="Users">Users</a>
        <a asp-action="Teams">Teams</a>
        <a asp-action="Notifications" class="active">Notifications</a>
        <a asp-action="Settings">Settings</a>
        <a asp-action="Categories">Categories</a>
        <a asp-action="Difficulties">Difficulties</a>
    </div>

    <form method="post" asp-action="AddNotification" class="form form-wide">
        <h3 style="margin:0; color:var(--text-white);">通知を配信</h3>
        <label>タイトル<input name="title" required maxlength="200" /></label>
        <label>本文<textarea name="content" rows="4"></textarea></label>
        <button type="submit">配信</button>
    </form>

    <h2 style="margin-top:24px;">配信済み通知</h2>
    <table class="table">
        <thead><tr><th>配信日時</th><th>タイトル</th><th>本文</th><th>操作</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" class="coming-soon">通知はまだありません。</td></tr>
        }
        else
        {
            foreach (var n in Model)
            {
                <tr>
                    <td style="white-space:nowrap;">@n.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@n.Title</td>
                    <td style="white-space:pre-wrap;">@n.Content</td>
                    <td>
                        <form method="post" asp-action="DeleteNotification" asp-route-id="@n.Id" style="display:inline;" onsubmit="return confirm('この通知を削除しますか？')">
                            <button type="submit" class="btn-danger" style="padding:4px 10px; font-size:12px;">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</section>
